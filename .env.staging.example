# Staging environment for docker-compose.staging.yml. See DEPLOYMENT.md §9.
#
# Copy to .env.staging in the SEPARATE staging checkout
# (/home/ubuntu/finance-tracker-staging), never in the production one, and run:
#
#   docker compose --env-file .env.staging -f docker-compose.staging.yml up -d --build

# --- Domains (DNS A/AAAA records must point at this VPS) ---
FRONTEND_DOMAIN=stagfinance.ivanleekaikiat.com
API_DOMAIN=stagfinanceapi.ivanleekaikiat.com
# Parent domain so the auth cookie is shared between the two staging subdomains.
# It is the same value production uses, and it has to be: the parent is the only
# common ancestor of the frontend and API hosts. What keeps the two stacks' logins
# apart is AUTH_COOKIE_PREFIX below, not this.
AUTH_COOKIE_DOMAIN=.ivanleekaikiat.com

# Renames this stack's session cookies to staging_access_token /
# staging_refresh_token. A cookie is keyed by (name, domain, path), so without a
# distinct name a staging login would overwrite production's session outright.
# Choosing a narrower staging subdomain does NOT solve it — production's
# parent-scoped cookie is sent to every subdomain of the zone, leaving the browser
# holding two cookies of the same name whose send order is undefined here.
# docker-compose.staging.yml already defaults this to `staging_`; set it only to
# override. Production sets nothing and keeps the original names.
#AUTH_COOKIE_PREFIX=staging_

# --- Database (a Neon BRANCH of the production branch, not production itself) ---
# Reset the branch from its parent before each migration rehearsal, or you are
# testing a migration against a database that already has it.
DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/fin?sslmode=require

# --- Application secrets ---
# ALL THREE MUST DIFFER FROM .env.production. Generate fresh values:
#   printf 'SECRET_KEY=%s\nSCHEDULER_SECRET=%s\nWEBHOOK_SECRET=%s\n' \
#     "$(openssl rand -hex 32)" "$(openssl rand -hex 24)" "$(openssl rand -hex 32)"
#
# JWT signing key. Sharing production's would let a staging-minted token
# authenticate against production.
SECRET_KEY=change-me
# Shared secret for the daily snapshot cron job.
SCHEDULER_SECRET=change-me

# --- Continuous deployment (deploy/webhook) ---
# Absolute path to the STAGING checkout on this VPS. Must be the real host path,
# not a container-local alias — see the `webhook` service comment in
# docker-compose.prod.yml for why.
REPO_DIR=/home/ubuntu/finance-tracker-staging
# Absolute path to the host user's SSH dir (key + known_hosts) with git-pull access.
SSH_DIR=/home/ubuntu/.ssh
# Must match the secret on the SECOND GitHub webhook (the one pointing at
# https://$API_DOMAIN/hooks/deploy). This is the only thing between the internet
# and a container holding the host's Docker socket, so it must be its own value.
WEBHOOK_SECRET=change-me
# Staging tracks dev; production's webhook watches refs/heads/main and ignores this.
DEPLOY_BRANCH=refs/heads/dev
