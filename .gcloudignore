# .gcloudignore

# Use this file to skip files and directories when uploading source to Google Cloud.

# Git

.git/
.gitignore

# Python

**/**pycache**/
**/.pytest_cache/
**/.venv/
**/.uv_cache/
**/.python-version
**/\*.pyc

# Node / Frontend

**/node_modules/
**/.pnpm-store/
\*\*/.react-router/
frontend/build/
frontend/.env.production

# Environment files

.env
.env.\*
!.env.example

# IDEs and OS

.idea/
.vscode/
.DS_Store

# Docker (handled by individual service builds, no need to upload if they are local artifacts)

\*_/.dockerignore
docker-compose_.yml

# Mobile Apps

ios/
android/
