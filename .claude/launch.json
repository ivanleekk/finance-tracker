{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "CORS_ORIGINS=http://localhost:5173,http://localhost:5174 uv run uvicorn src.main:app --host 0.0.0.0 --port 8000"],
      "cwd": "backend",
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "frontend",
      "runtimeExecutable": "node_modules/.bin/react-router",
      "runtimeArgs": ["dev"],
      "cwd": "frontend",
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "frontend-local",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "INTERNAL_API_URL=http://localhost:8000 node_modules/.bin/react-router dev --port 5174"],
      "cwd": "frontend",
      "port": 5174,
      "autoPort": false
    },
    {
      "name": "frontend-session",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "INTERNAL_API_URL=http://localhost:8000 node_modules/.bin/react-router dev --port 5175"],
      "cwd": "frontend",
      "port": 5175,
      "autoPort": true
    }
  ]
}
