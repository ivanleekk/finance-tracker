# Production environment for docker-compose.prod.yml.
# Copy to .env.production on the VPS (never commit the real file) and run:
#
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build

# --- Domains (DNS A/AAAA records must point at this VPS) ---
FRONTEND_DOMAIN=finance.ivanleekaikiat.com
API_DOMAIN=financeapi.ivanleekaikiat.com
# Parent domain so the auth cookie is shared between the two subdomains
AUTH_COOKIE_DOMAIN=.ivanleekaikiat.com
# Let's Encrypt expiry/problem notifications
ACME_EMAIL=you@example.com

# --- Database (Neon, managed Postgres — no local db container) ---
# Use Neon's pooled connection string (pgbouncer) with sslmode=require.
DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/fin?sslmode=require

# --- Application secrets ---
# JWT signing key. Generate: openssl rand -hex 32
SECRET_KEY=change-me
# Shared secret for the daily snapshot cron job. Generate: openssl rand -hex 24
SCHEDULER_SECRET=change-me
